# Copy to .env and fill in. Never commit .env.
PORT=5050

# SMTP settings for the contact form. For Gmail, create an App Password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kiplangatkevin00@gmail.com
SMTP_PASS=your-app-password

# Where contact messages are delivered (defaults to SMTP_USER)
CONTACT_TO=kiplangatkevin00@gmail.com

# Public URL of the deployed site, used for absolute links in social previews (no trailing slash)
VITE_SITE_URL=https://your-domain.com
